<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        xmlns:gsr="http://www.rte-france.com/gsr"
        targetNamespace="http://www.rte-france.com/gsr"
        elementFormDefault="qualified"
        attributeFormDefault="unqualified">

    <simpleType name="recDate">
        <restriction base="token">
            <pattern value="[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2}"></pattern>
        </restriction>
    </simpleType>

    <complexType name="record">
        <simpleContent>
            <extension base="string">
                <attribute name="dt" type="gsr:recDate" use="required"/>
                <attribute name="level" type="string" use="required"/>
            </extension>
        </simpleContent>
    </complexType>

    <complexType name="context">
        <choice minOccurs="0" maxOccurs="unbounded">
            <element name="rec" type="gsr:record" />
            <element name="ctxt" type="gsr:context" />
        </choice>
        <attribute name="nom" type="string" />
    </complexType>

    <complexType name="logs">
        <sequence>
            <element name="ctxt" type="gsr:context" minOccurs="0" maxOccurs="unbounded" />
        </sequence>
    </complexType>

    <element name="logs" type="gsr:logs"/>

</schema>